# Google Cloud Configuration (No hardcoded secrets in code!)
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=us-central1
GOOGLE_GENAI_USE_VERTEXAI=true

# Secret Manager Secret IDs (fetched at runtime via SecretManagerClient)
GEMINI_API_KEY_SECRET_ID=tabflow-gemini-api-key

# Application & Database Configuration
TABFLOW_DB_PATH=data/tabflow_state.db
TABFLOW_PORT=8080
LOG_LEVEL=INFO

